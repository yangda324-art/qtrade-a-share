# ============================================================
# qtrade 环境变量示例
# ------------------------------------------------------------
# 1. 复制本文件为 .env：cp .env.example .env
# 2. 填入你自己的 key
# 3. .env 已在 .gitignore 中，不会被提交
# ============================================================

# ---- LLM Providers ----
# DeepSeek 是默认主用模型；其它做 fallback，可选
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_DEEP=deepseek-reasoner       # 复杂推理（研究员辩论 / 决策合成）
DEEPSEEK_MODEL_QUICK=deepseek-chat          # 快速分析（技术分析 / 舆情）

# 可选 fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- 数据源 ----
# Tushare（可选，免费用户也能拿日线，部分高级接口需要积分）
TUSHARE_TOKEN=

# ---- 券商接入（Phase 2 之后才用，先留空） ----
# 掘金量化
GM_TOKEN=
GM_STRATEGY_ID=
GM_ACCOUNT_ID=

# ---- 告警通道（可选） ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SERVERCHAN_KEY=                              # 微信推送

# ---- 运行环境 ----
QTRADE_ENV=dev                               # dev / paper / live
QTRADE_LOG_LEVEL=INFO
QTRADE_DATA_DIR=./data
QTRADE_LOG_DIR=./logs
